# API Configuration
# For development, use: http://localhost:5000/api
# For production, use your deployed backend URL
VITE_API_URL=http://localhost:5000/api

# Frontend Configuration
VITE_APP_NAME=E-Soko
VITE_APP_VERSION=1.0.0

# Admin Configuration
# ⚠️ SECURITY: Change this to a strong, unique password!
# This password is used for frontend admin authentication
# Example: Use a password manager to generate a secure password
# Requirements: At least 12 characters, mix of letters, numbers, and symbols
VITE_ADMIN_PASSWORD=ChangeMeToSecurePassword123!

# How to access admin portal:
# Method 1: Tap the E-Soko logo 7 times (mobile-friendly)
# Method 2: Press Ctrl+Shift+A (desktop shortcut)

# Google AdSense Configuration
# ⚠️ IMPORTANT: Replace these placeholder values with your real AdSense IDs
#
# For Vercel deployment:
# 1. Go to your Vercel project → Settings → Environment Variables
# 2. Add each variable below with your REAL values (not the placeholders)
#
# How to get your AdSense IDs:
# 1. Go to https://www.google.com/adsense/
# 2. Navigate to: Ads → By ad unit → New ad unit
# 3. Create 5 responsive ad units (Banner, Sidebar, Footer, Header, Default)
# 4. Copy each Ad Slot ID (10-digit number) and use in Vercel
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_BANNER=XXXXXXXXXX
VITE_ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX
VITE_ADSENSE_SLOT_FOOTER=XXXXXXXXXX
VITE_ADSENSE_SLOT_HEADER=XXXXXXXXXX
VITE_ADSENSE_SLOT_DEFAULT=XXXXXXXXXX
