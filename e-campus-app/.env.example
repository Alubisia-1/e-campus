# API Configuration
# For development, use: http://localhost:5000/api
# For production, use your deployed backend URL
VITE_API_URL=http://localhost:5000/api

# Frontend Configuration
VITE_APP_NAME=E-Soko
VITE_APP_VERSION=1.0.0

# Admin Configuration
# The admin account is a normal user with role "admin". Log in through the
# standard Sign In form. Create/update it on the backend with:
#   npm run create-admin "YourStrongPassword"
# There are no admin-related frontend env vars.
