# API Configuration
# For development, use: http://localhost:5000/api
# For production, use your deployed backend URL
VITE_API_URL=http://localhost:5000/api

# Frontend Configuration
VITE_APP_NAME=E-Campus Marketplace
VITE_APP_VERSION=1.0.0

# Admin Configuration (for frontend-only demo mode)
# NOTE: In production, move authentication to backend
VITE_ADMIN_PASSWORD=your_secure_admin_password_here

# Google AdSense Configuration
# Publisher ID is already set! ✅
# Next: Create ad units in AdSense dashboard and add the Slot IDs below
# 1. Go to https://www.google.com/adsense/
# 2. Navigate to: Ads → By ad unit → New ad unit
# 3. Create 5 responsive ad units (Banner, Sidebar, Footer, Header, Default)
# 4. Copy each Ad Slot ID (10-digit number) and paste below
VITE_ADSENSE_CLIENT=ca-pub-7406671560728064
VITE_ADSENSE_SLOT_BANNER=1234567890
VITE_ADSENSE_SLOT_SIDEBAR=1234567891
VITE_ADSENSE_SLOT_FOOTER=1234567892
VITE_ADSENSE_SLOT_HEADER=1234567893
VITE_ADSENSE_SLOT_DEFAULT=1234567894
