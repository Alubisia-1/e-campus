# Server Configuration
PORT=5000
NODE_ENV=production

# Database - MongoDB Atlas
# Replace with your MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/e-campus?retryWrites=true&w=majority

# JWT Configuration
# IMPORTANT: Generate a strong random secret (minimum 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d

# Cloudinary Configuration (for image uploads)
# Sign up at: https://cloudinary.com
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (for CORS)
# Update with your production frontend URL
FRONTEND_URL=https://your-domain.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (REQUIRED to run more than one backend instance)
# Shares the cache and rate-limit counters across all instances. Without it each
# instance keeps its own in-memory cache/limits, so they drift and the limits are
# effectively multiplied by the instance count.
# Use the connection string from your managed provider (Upstash, Render, Redis Cloud).
REDIS_URL=rediss://default:your_password@your-host:6379
# Optional cache key namespace (default: cache:)
# REDIS_PREFIX=cache:

# Official Store Contact Information
# Update these with your actual contact details
OFFICIAL_STORE_EMAIL=store@your-campus.edu
OFFICIAL_STORE_PHONE=+1-XXX-XXX-XXXX

# Email Configuration (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Additional Security (Optional)
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# MAX_FILE_SIZE=5242880
