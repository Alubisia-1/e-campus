# ============================================
# E-CAMPUS BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update with your actual values
# NEVER commit the .env file to version control!

# ============================================
# SERVER CONFIGURATION
# ============================================

# The port on which the server will run
PORT=5000

# Application environment: development, production, or test
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB connection string
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/ecampus

# For MongoDB Atlas (recommended for production):
# Replace <username>, <password>, and <cluster> with your actual values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecampus?retryWrites=true&w=majority

# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://ecampus_user:mySecurePassword123@cluster0.abc123.mongodb.net/ecampus?retryWrites=true&w=majority

# ============================================
# JWT AUTHENTICATION
# ============================================

# Secret key for JWT token signing
# IMPORTANT: Use a strong, random string (minimum 32 characters)
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-string-min-32-chars

# JWT token expiration time
# Examples: 1h, 7d, 30d, 90d
# Default: 30d (30 days)
JWT_EXPIRE=30d

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
# Sign up at https://cloudinary.com to get these credentials
# Used for image upload and storage

# Your Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Your Cloudinary API key
CLOUDINARY_API_KEY=your-api-key

# Your Cloudinary API secret
CLOUDINARY_API_SECRET=your-api-secret

# How to get Cloudinary credentials:
# 1. Go to https://cloudinary.com and sign up for a free account
# 2. After logging in, go to Dashboard
# 3. You'll find Cloud Name, API Key, and API Secret there
# 4. Copy and paste them above

# ============================================
# CORS CONFIGURATION
# ============================================

# Frontend application URL (for CORS)
# Update this to match your frontend development/production URL
FRONTEND_URL=http://localhost:5174

# For production, use your actual frontend domain:
# FRONTEND_URL=https://ecampus.yourdomain.com

# ============================================
# RATE LIMITING (Optional)
# ============================================
# These are optional - the app has default values if not specified

# Time window for rate limiting in milliseconds
# Default: 900000 (15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per window
# Default: 100 requests per 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# EMAIL CONFIGURATION (Optional - Future Use)
# ============================================
# For email verification and notifications (not yet implemented)

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=E-Campus <noreply@ecampus.com>

# ============================================
# ADDITIONAL NOTES
# ============================================

# Security Best Practices:
# 1. Never commit the .env file to version control
# 2. Use strong, unique values for JWT_SECRET
# 3. In production, set NODE_ENV to "production"
# 4. Use HTTPS in production (update FRONTEND_URL accordingly)
# 5. Rotate secrets regularly
# 6. Use environment-specific configurations

# MongoDB Atlas Setup:
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Create a database user with a strong password
# 3. Whitelist your IP address (or 0.0.0.0/0 for development)
# 4. Get the connection string from "Connect" > "Connect your application"
# 5. Replace <password> with your database user password

# File Upload Limits:
# - Maximum 3 images per product
# - Images are automatically optimized to WebP format
# - Maximum file size: 5MB per image (configurable in upload middleware)
# - Supported formats: JPEG, PNG, WebP

# Default User Roles:
# - user: Regular student user (default)
# - admin: Administrator with full access
